<?xml version="1.0" encoding="utf-8"?>
<!-- Point 1: a single subtype was getting shown as the PRIMARY label in the
     system's "Choose input method" quick switcher popup (a known Android
     quirk when an IME declares exactly one subtype), even though it correctly
     stayed a small subtitle in "Manage on-screen keyboards". Declaring two
     subtypes - one per language this keyboard actually supports - is the
     standard workaround multi-language keyboards use: it stops the picker
     from merging a subtype label into the primary row, while "Manage
     keyboards" still shows a subtitle. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="">
    <subtype
        android:label="@string/ime_subtype_label"
        android:imeSubtypeLocale="en_US"
        android:imeSubtypeMode="keyboard" />
    <subtype
        android:label="@string/ime_subtype_label"
        android:imeSubtypeLocale="bn_BD"
        android:imeSubtypeMode="keyboard" />
</input-method>
