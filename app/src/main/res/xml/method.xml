<?xml version="1.0" encoding="utf-8"?>
<!-- Point 1: a <subtype android:label="..."> here also shows up as the
     primary two-line entry in the system's "Choose input method" quick
     switcher popup (pushing the app name to a subtitle there too), not just
     in "Manage on-screen keyboards" as intended - so it's left out entirely
     to keep that quick-switcher showing a clean single "BlockVeil Keyboard"
     line like every other keyboard app. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="" />
