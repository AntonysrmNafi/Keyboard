<?xml version="1.0" encoding="utf-8"?>
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:keyHeight="50dp"
    android:horizontalGap="2%p"
    android:verticalGap="6dp">

    <!-- Row 1: ড় ঢ় ঙ ... numbers -->
    <Row>
        <Key android:codes="2524" android:keyLabel="ড়" />
        <Key android:codes="2525" android:keyLabel="ঢ়" />
        <Key android:codes="2503" android:keyLabel="ঙ" />
        <Key android:codes="2495" android:keyLabel="৫" />
        <Key android:codes="2496" android:keyLabel="৬" />
        <Key android:codes="2497" android:keyLabel="৭" />
        <Key android:codes="2498" android:keyLabel="৮" />
        <Key android:codes="2499" android:keyLabel="৯" />
        <Key android:codes="2500" android:keyLabel="০" />
    </Row>

    <!-- Row 2: (spacer) দ র য ব ট গ ঘ জ ড (spacer) -->
    <Row>
        <Key android:codes="-99" android:keyLabel="" android:keyWidth="5%p" />
        <Key android:codes="2470" android:keyLabel="দ" />
        <Key android:codes="2480" android:keyLabel="র" />
        <Key android:codes="2479" android:keyLabel="য" />
        <Key android:codes="2476" android:keyLabel="ব" />
        <Key android:codes="2463" android:keyLabel="ট" />
        <Key android:codes="2455" android:keyLabel="গ" />
        <Key android:codes="2456" android:keyLabel="ঘ" />
        <Key android:codes="2460" android:keyLabel="জ" />
        <Key android:codes="2469" android:keyLabel="ড" />
        <Key android:codes="-99" android:keyLabel="" android:keyWidth="5%p" />
    </Row>

    <!-- Row 3: Shift ত স প ক ম ন ধ Backspace -->
    <Row>
        <Key android:codes="-1" android:keyLabel="&#8679;" android:keyWidth="15%p" android:isModifier="true" android:isSticky="true" />
        <Key android:codes="2468" android:keyLabel="ত" />
        <Key android:codes="2488" android:keyLabel="স" />
        <Key android:codes="2474" android:keyLabel="প" />
        <Key android:codes="2453" android:keyLabel="ক" />
        <Key android:codes="2473" android:keyLabel="ম" />
        <Key android:codes="2467" android:keyLabel="ন" />
        <Key android:codes="2471" android:keyLabel="ধ" />
        <Key android:codes="-5" android:keyLabel="&#9003;" android:keyWidth="15%p" />
    </Row>

    <!-- Row 4: ?123 space Enter -->
    <Row>
        <Key android:codes="-20" android:keyLabel="\?123" android:keyWidth="20%p" />
        <Key android:codes="32" android:keyLabel="space" android:keyWidth="60%p" />
        <Key android:codes="-3" android:keyLabel="&#10003;" android:keyWidth="20%p" />
    </Row>
</Keyboard>
