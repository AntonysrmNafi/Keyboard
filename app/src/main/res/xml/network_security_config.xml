<?xml version="1.0" encoding="utf-8"?>
<!--
  Point 3: block the app from the network at the platform level, on top of the fact
  that it does not request the INTERNET permission at all. Without that permission
  Android refuses every socket the app could ever open, so this file cannot enable
  network access - it can only make the "no network" guarantee stricter. It forbids
  plain HTTP for the whole app and trusts no certificate authorities, so even a
  future accidental network-capable dependency (e.g. a WebView) would still be
  refused rather than silently allowed.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Intentionally empty: no certificate authority is trusted. -->
        </trust-anchors>
    </base-config>
</network-security-config>
