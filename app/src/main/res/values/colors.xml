         but that was just that app's own state at the time - not something
         to copy verbatim, since BlockVeil's Settings has always been dark. -->
    <color name="clipboard_settings_bg">@color/bg_dark</color>
    <color name="clipboard_settings_card_bg">@color/key_function</color>
    <color name="clipboard_settings_text_primary">@color/text_primary</color>
