<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Point: extra transparent space reserved above the visible keyboard
         so multi-hint popups (long-press grids like the '.' or 'u' picker)
         always have room to render in full, even when they'd otherwise
         need to extend above the keyboard's own top edge. This value is
         read in Kotlin too (BlockVeilInputMethodService.onComputeInsets)
         so the system knows this reserved strip is NOT part of the actual
         keyboard for app-layout/touch purposes - keep both in sync if you
         change this. Sized for the tallest configured popup (2 rows) with
         headroom; lower it if popups never need this much space, raise it
         if a popup is still getting clipped at the very top of the screen.
    -->
    <dimen name="hint_popup_reserve_height">140dp</dimen>
</resources>
