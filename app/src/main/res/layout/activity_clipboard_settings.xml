<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/clipboard_settings_bg">

    <!-- Normal top bar: back arrow, "Clipboard" title, + add button -->
    <LinearLayout
        android:id="@+id/clipboard_normal_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/clipboard_back_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/arrow_back_24"
            android:tint="@color/clipboard_settings_text_primary"
            android:contentDescription="@string/back_arrow"
            android:paddingEnd="16dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clipboard_title"
            android:textColor="@color/clipboard_settings_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/clipboard_add_button"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_add_24"
            android:tint="@color/clipboard_settings_text_primary"
            android:contentDescription="@string/clipboard_add_entry" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/clipboard_empty_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/clipboard_settings_text_secondary"
                android:textSize="14sp"
                android:padding="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/clipboard_pinned_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pinned_section_header"
                android:textAllCaps="true"
                android:textColor="@color/clipboard_settings_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:visibility="gone" />

            <!-- Point: two SEPARATE RecyclerViews (not one list with mixed
                 view types) so drag-to-reorder can never accidentally drag a
                 pinned item into the unpinned group or vice versa - each
                 ItemTouchHelper is scoped to its own RecyclerView, so
                 cross-section dragging isn't just prevented in code, it's
                 structurally impossible. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/clipboard_pinned_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <!-- Point: a thin divider between the Pinned and Recent groups,
                 only shown when both are non-empty (see
                 ClipboardSettingsActivity.refresh) - without it, when a
                 Pinned section ends right where Recent begins, the two ran
                 together with nothing marking the boundary. -->
            <View
                android:id="@+id/clipboard_section_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@color/clipboard_settings_text_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/clipboard_recent_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clipboard_recent_header"
                android:textAllCaps="true"
                android:textColor="@color/clipboard_settings_text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:padding="12dp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/clipboard_unpinned_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
