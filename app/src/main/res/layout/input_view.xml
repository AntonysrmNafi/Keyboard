<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/ime_bg"
    android:paddingTop="6dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:id="@+id/suggestion_strip"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:background="@color/ime_bg"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/icon_text_tool"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/icon_text_tool"
            android:textColor="@color/ime_key_function"
            android:textStyle="bold"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/toolbar_icons_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/icon_emoji_top"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:src="@drawable/sentiment_satisfied_24"
                android:tint="@color/ime_key_function"
                android:scaleType="centerInside" />

            <ImageView
                android:id="@+id/clipboard_button"
                android:layout_width="0dp"
                android:layout_height="24dp"
                android:layout_weight="1"
                android:src="@drawable/ic_top_clipboard"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/icon_123_top"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/icon_123_top"
                android:textColor="@color/ime_key_function"
                android:textStyle="bold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/icon_more_options"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/icon_more_options"
                android:textColor="@color/ime_key_function"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/settings_header_button"
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:src="@drawable/ic_settings_gear"
                android:scaleType="centerInside" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/suggestions_group"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/suggestion_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/ime_suggestion_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/suggestion_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/ime_suggestion_text"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/suggestion_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/ime_suggestion_text"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="310dp">

        <com.privacykeyboard.app.BlockVeilKeyboardView
            android:id="@+id/keyboard_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ime_bg"
            android:shadowColor="#00000000"
            android:shadowRadius="0" />

        <LinearLayout
            android:id="@+id/clipboard_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/ime_bg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp">

                <ImageView
                    android:id="@+id/clipboard_close_button"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/arrow_back_24"
                    android:tint="@color/ime_text_primary"
                    android:contentDescription="@string/back_arrow"
                    android:paddingEnd="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/clipboard_clear_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_all"
                    android:textColor="@color/ime_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/clipboard_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/emoji_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/ime_bg"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/emoji_category_row"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:background="@color/ime_bg" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E0E0E0" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/ime_bg">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/emoji_coming_soon"
                    android:textColor="@color/ime_text_secondary"
                    android:textSize="13sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/ime_bg"
                android:padding="8dp">

                <TextView
                    android:id="@+id/emoji_abc_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABC"
                    android:textColor="@color/ime_key_function"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:padding="8dp" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
